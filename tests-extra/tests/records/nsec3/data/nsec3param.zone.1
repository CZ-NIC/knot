$ORIGIN nsec3param.
$TTL 3600

@	SOA	dns1 hostmaster 2010111202 10800 3600 1209600 7200
	NS	dns1
	NS	dns2
	MX	10 mail

dns1	A	192.0.2.1
	AAAA	2001:DB8::1

dns2	A	192.0.2.2
	AAAA	2001:DB8::2

mail	A	192.0.2.3
	AAAA	2001:DB8::3

; NSEC3PARAM with too many iterations
@ NSEC3PARAM 1 0 257 -

; RRSIG of SOA required to trigger DNSSEC processing
@ RRSIG SOA 13 1 3600 20991231235959 20200101000001 12345 nsec3param. AA==
